{
  "$defs": {
    "Accessory": {
      "enum": [
        "glasses",
        "sunglasses",
        "cap",
        "beanie",
        "headphones",
        "scarf",
        "backpack",
        "apron"
      ],
      "title": "Accessory",
      "type": "string"
    },
    "Appearance": {
      "additionalProperties": false,
      "description": "What a character looks like, for the sprite generator. Colours are #rrggbb.",
      "properties": {
        "skin": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Skin",
          "type": "string"
        },
        "hair_style": {
          "$ref": "#/$defs/HairStyle"
        },
        "hair_colour": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Hair Colour",
          "type": "string"
        },
        "top_colour": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Top Colour",
          "type": "string"
        },
        "bottom_colour": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Bottom Colour",
          "type": "string"
        },
        "shoe_colour": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Shoe Colour",
          "type": "string"
        },
        "build": {
          "$ref": "#/$defs/Build"
        },
        "accessories": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Accessory"
          },
          "title": "Accessories",
          "type": "array"
        }
      },
      "required": [
        "skin",
        "hair_style",
        "hair_colour",
        "top_colour",
        "bottom_colour",
        "shoe_colour",
        "build",
        "accessories"
      ],
      "title": "Appearance",
      "type": "object"
    },
    "Build": {
      "enum": [
        "slim",
        "average",
        "broad"
      ],
      "title": "Build",
      "type": "string"
    },
    "CoreValue": {
      "enum": [
        "freedom",
        "independence",
        "self_respect",
        "self_actualization",
        "creativity",
        "honesty",
        "compassion",
        "loyalty",
        "justice",
        "responsibility",
        "security",
        "equality",
        "tradition",
        "obedience",
        "success",
        "ambition",
        "discipline",
        "knowledge",
        "open_mindedness",
        "peace_of_mind",
        "pleasure",
        "connection",
        "adventure",
        "optimism"
      ],
      "title": "CoreValue",
      "type": "string"
    },
    "Craft": {
      "additionalProperties": false,
      "description": "What a resident makes in their own time, which can differ from their job.",
      "properties": {
        "medium": {
          "$ref": "#/$defs/Medium"
        },
        "form": {
          "description": "What they make, in a few words, e.g. \"short poems about the river\".",
          "minLength": 1,
          "title": "Form",
          "type": "string"
        }
      },
      "required": [
        "medium",
        "form"
      ],
      "title": "Craft",
      "type": "object"
    },
    "HairStyle": {
      "enum": [
        "bald",
        "buzz",
        "short",
        "curly",
        "bob",
        "long",
        "ponytail",
        "bun"
      ],
      "title": "HairStyle",
      "type": "string"
    },
    "Humour": {
      "additionalProperties": false,
      "description": "Their sense of humour: its style, and how seldom they joke.",
      "properties": {
        "style": {
          "$ref": "#/$defs/HumourStyle"
        },
        "seriousness": {
          "description": "How seldom they joke, 0-1: at 0 they joke in most lines, at 1 never.",
          "maximum": 1,
          "minimum": 0,
          "title": "Seriousness",
          "type": "number"
        }
      },
      "required": [
        "style",
        "seriousness"
      ],
      "title": "Humour",
      "type": "object"
    },
    "HumourStyle": {
      "enum": [
        "dry",
        "deadpan",
        "sarcastic",
        "cynical",
        "punning",
        "silly",
        "teasing",
        "gallows",
        "none"
      ],
      "title": "HumourStyle",
      "type": "string"
    },
    "Medium": {
      "enum": [
        "writing",
        "mural",
        "painting"
      ],
      "title": "Medium",
      "type": "string"
    },
    "Pay": {
      "additionalProperties": false,
      "description": "How a resident is paid, in the same units as their `money`.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/PayKind"
        },
        "amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per hour worked for a `wage`, per week for a `pension`, null for `takings`.",
          "title": "Amount"
        }
      },
      "required": [
        "kind",
        "amount"
      ],
      "title": "Pay",
      "type": "object"
    },
    "PayKind": {
      "description": "`wage`: `amount` per hour worked, for work done for people outside the village. `takings`:\nwhat their shop takes minus its supplies, so no `amount`. `pension`: `amount` per week.",
      "enum": [
        "wage",
        "takings",
        "pension"
      ],
      "title": "PayKind",
      "type": "string"
    },
    "Shift": {
      "additionalProperties": false,
      "description": "When a resident works on some days of the week. Times are hours on the sim clock, so 7.5\nis 07:30. A shift that runs past midnight is two shifts: one ending at 24 and one starting at\n0 the next day.",
      "properties": {
        "days": {
          "items": {
            "$ref": "#/$defs/Weekday"
          },
          "minItems": 1,
          "title": "Days",
          "type": "array"
        },
        "start": {
          "description": "When it starts, 0-24.",
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "description": "When it ends, after it starts and at most 24.",
          "maximum": 24,
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "days",
        "start",
        "end"
      ],
      "title": "Shift",
      "type": "object"
    },
    "Voice": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "What the voice sounds like, for the voice design model.",
          "title": "Description",
          "type": "string"
        },
        "reference_line": {
          "description": "A neutral line in character, 5-10 seconds of speech. The clip's transcript.",
          "title": "Reference Line",
          "type": "string"
        },
        "reference_clip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The recorded reference clip, relative to the repository root. Null until the voice is designed.",
          "title": "Reference Clip"
        }
      },
      "required": [
        "description",
        "reference_line",
        "reference_clip"
      ],
      "title": "Voice",
      "type": "object"
    },
    "Weekday": {
      "enum": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ],
      "title": "Weekday",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "age": {
      "maximum": 120,
      "minimum": 0,
      "title": "Age",
      "type": "integer"
    },
    "occupation": {
      "title": "Occupation",
      "type": "string"
    },
    "home": {
      "description": "Location id of their house.",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Home",
      "type": "string"
    },
    "workplace": {
      "anyOf": [
        {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Location id of where they work, their `home` for remote work. Null if they don't work, and left out.",
      "title": "Workplace"
    },
    "shifts": {
      "default": [],
      "description": "When they work, at their workplace. Empty if they don't work, and left out.",
      "items": {
        "$ref": "#/$defs/Shift"
      },
      "title": "Shifts",
      "type": "array"
    },
    "pay": {
      "anyOf": [
        {
          "$ref": "#/$defs/Pay"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "How they're paid. Null with no income, and left out."
    },
    "money": {
      "default": 0.0,
      "description": "What they start with. Left out when 0.",
      "minimum": 0,
      "title": "Money",
      "type": "number"
    },
    "values": {
      "additionalProperties": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "description": "How much they care about each of the 24 core values, 0-1. All are present.",
      "propertyNames": {
        "$ref": "#/$defs/CoreValue"
      },
      "title": "Values",
      "type": "object"
    },
    "backstory": {
      "title": "Backstory",
      "type": "string"
    },
    "persona": {
      "title": "Persona",
      "type": "string"
    },
    "speaking_style": {
      "title": "Speaking Style",
      "type": "string"
    },
    "mannerisms": {
      "default": [],
      "description": "Up to 3 habits that show in how they talk, e.g. \"answers a question with another question\". Left out when empty.",
      "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 3,
      "title": "Mannerisms",
      "type": "array"
    },
    "humour": {
      "anyOf": [
        {
          "$ref": "#/$defs/Humour"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Null when unset, and left out."
    },
    "interests": {
      "items": {
        "type": "string"
      },
      "title": "Interests",
      "type": "array"
    },
    "appearance": {
      "$ref": "#/$defs/Appearance"
    },
    "voice": {
      "$ref": "#/$defs/Voice"
    },
    "craft": {
      "anyOf": [
        {
          "$ref": "#/$defs/Craft"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Null if they don't make anything."
    }
  },
  "required": [
    "id",
    "name",
    "age",
    "occupation",
    "home",
    "values",
    "backstory",
    "persona",
    "speaking_style",
    "interests",
    "appearance",
    "voice",
    "craft"
  ],
  "title": "Npc",
  "type": "object"
}
