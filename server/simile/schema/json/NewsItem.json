{
  "$defs": {
    "CoreValue": {
      "enum": [
        "freedom",
        "independence",
        "self_respect",
        "self_actualization",
        "creativity",
        "honesty",
        "compassion",
        "loyalty",
        "justice",
        "responsibility",
        "security",
        "equality",
        "tradition",
        "obedience",
        "success",
        "ambition",
        "discipline",
        "knowledge",
        "open_mindedness",
        "peace_of_mind",
        "pleasure",
        "connection",
        "adventure",
        "optimism"
      ],
      "title": "CoreValue",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "The feed entry's guid.",
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "url": {
      "title": "Url",
      "type": "string"
    },
    "summary": {
      "description": "Plain text, HTML stripped.",
      "title": "Summary",
      "type": "string"
    },
    "published": {
      "format": "date-time",
      "title": "Published",
      "type": "string"
    },
    "source": {
      "default": "",
      "description": "The display name of the feed it came from, e.g. \"The Atlantic\". Empty for items stored before sources were recorded.",
      "title": "Source",
      "type": "string"
    },
    "source_url": {
      "default": "",
      "description": "The URL of the feed it came from. Empty for items stored before sources were recorded.",
      "title": "Source Url",
      "type": "string"
    },
    "values": {
      "additionalProperties": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "default": {},
      "description": "How related the article is to each of the 24 core values, 0-1, with no direction: an article that clashes with a value relates to it as much as one that upholds it. Empty until analysed, then all are present.",
      "propertyNames": {
        "$ref": "#/$defs/CoreValue"
      },
      "title": "Values",
      "type": "object"
    },
    "tags": {
      "default": [],
      "description": "Up to 10 short topic tags, e.g. \"drones\". Empty until analysed.",
      "items": {
        "maxLength": 40,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Tags",
      "type": "array"
    },
    "sentiment": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The article's overall tone, from -1 (very negative) to 1 (very positive). Null until analysed.",
      "title": "Sentiment"
    }
  },
  "required": [
    "id",
    "title",
    "url",
    "summary",
    "published",
    "source",
    "source_url",
    "values",
    "tags",
    "sentiment"
  ],
  "title": "NewsItem",
  "type": "object"
}
