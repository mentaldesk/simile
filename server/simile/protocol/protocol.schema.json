{
  "title": "Message",
  "$defs": {
    "Artist": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Artist",
      "type": "object"
    },
    "ClientMessage": {
      "discriminator": {
        "mapping": {
          "list_news": "#/$defs/ListNewsMessage",
          "list_works": "#/$defs/ListWorksMessage",
          "player_move": "#/$defs/PlayerMoveMessage",
          "player_say": "#/$defs/PlayerSayMessage",
          "read_news": "#/$defs/ReadNewsMessage",
          "read_work": "#/$defs/ReadWorkMessage",
          "watch_npc": "#/$defs/WatchNpcMessage"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PlayerMoveMessage"
        },
        {
          "$ref": "#/$defs/PlayerSayMessage"
        },
        {
          "$ref": "#/$defs/WatchNpcMessage"
        },
        {
          "$ref": "#/$defs/ListNewsMessage"
        },
        {
          "$ref": "#/$defs/ReadNewsMessage"
        },
        {
          "$ref": "#/$defs/ListWorksMessage"
        },
        {
          "$ref": "#/$defs/ReadWorkMessage"
        }
      ]
    },
    "ClockMessage": {
      "additionalProperties": false,
      "description": "The sim clock, sent after the snapshot, when the speed changes and every sim minute.",
      "properties": {
        "type": {
          "const": "clock",
          "default": "clock",
          "type": "string"
        },
        "time": {
          "description": "Sim time.",
          "format": "date-time",
          "type": "string"
        },
        "speed": {
          "description": "Sim seconds per real second.",
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "type",
        "time",
        "speed"
      ],
      "title": "ClockMessage",
      "type": "object"
    },
    "Conversation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "participants": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "minItems": 2,
          "type": "array"
        },
        "started": {
          "format": "date-time",
          "type": "string"
        },
        "ended": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null while it's going on."
        },
        "lines": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Line"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "participants",
        "started",
        "ended",
        "lines"
      ],
      "title": "Conversation",
      "type": "object"
    },
    "ConversationEndedMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "conversation_ended",
          "default": "conversation_ended",
          "type": "string"
        },
        "conversation_id": {
          "minLength": 1,
          "type": "string"
        },
        "ended": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation_id",
        "ended"
      ],
      "title": "ConversationEndedMessage",
      "type": "object"
    },
    "ConversationStartedMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "conversation_started",
          "default": "conversation_started",
          "type": "string"
        },
        "conversation": {
          "$ref": "#/$defs/Conversation"
        }
      },
      "required": [
        "type",
        "conversation"
      ],
      "title": "ConversationStartedMessage",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "description": "The server always sends `pose` and `facing`. Missing, they're standing, facing south-east.",
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "name": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "facing": {
          "$ref": "#/$defs/Facing"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "position"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EntityKind": {
      "enum": [
        "npc",
        "player"
      ],
      "title": "EntityKind",
      "type": "string"
    },
    "EntityMovedMessage": {
      "additionalProperties": false,
      "description": "The server always sends `pose` and `facing`. Missing, they're standing, facing south-east.\nOn a side-view map, someone on stairs or a ladder is `climbing`. Taking stairs, a ladder or a\nlift to another map is an `entity_moved` at its end, `climbing` or `riding`, held for the climb\nor ride, then one onto the other map, as through a door.",
      "properties": {
        "type": {
          "const": "entity_moved",
          "default": "entity_moved",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "facing": {
          "$ref": "#/$defs/Facing"
        }
      },
      "required": [
        "type",
        "entity_id",
        "position"
      ],
      "title": "EntityMovedMessage",
      "type": "object"
    },
    "Face": {
      "description": "The way a wall faces. The iso camera sees only south and east faces, and a side-view map\nhas only south faces, towards the camera.",
      "enum": [
        "south",
        "east"
      ],
      "title": "Face",
      "type": "string"
    },
    "Facing": {
      "description": "Which way someone faces on the map, x east and y south, by angle from east through south.\nIn side view, the three eastward values face right and the westward ones left, `north` shows\ntheir back, looking into the picture, and `south` their front.",
      "enum": [
        "east",
        "south_east",
        "south",
        "south_west",
        "west",
        "north_west",
        "north",
        "north_east"
      ],
      "title": "Facing",
      "type": "string"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The painting interactable's id.",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "map": {
          "description": "The map the interactable is on.",
          "minLength": 1,
          "type": "string"
        },
        "painting": {
          "anyOf": [
            {
              "$ref": "#/$defs/Painting"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null while the frame is empty."
        }
      },
      "required": [
        "id",
        "map",
        "painting"
      ],
      "title": "Frame",
      "type": "object"
    },
    "JsonValue": {},
    "Line": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique across the world. Audio for the line carries it.",
          "minimum": 0,
          "type": "integer"
        },
        "conversation_id": {
          "minLength": 1,
          "type": "string"
        },
        "speaker": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "timestamp": {
          "description": "When the speaker starts saying it.",
          "format": "date-time",
          "type": "string"
        },
        "duration": {
          "description": "Estimated seconds to say it aloud.",
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "speaker",
        "text",
        "timestamp",
        "duration"
      ],
      "title": "Line",
      "type": "object"
    },
    "LineMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "line",
          "default": "line",
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/Line"
        },
        "voiced": {
          "description": "Whether audio_chunk frames will follow for this line.",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "line",
        "voiced"
      ],
      "title": "LineMessage",
      "type": "object"
    },
    "ListNewsMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "list_news",
          "default": "list_news",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ListNewsMessage",
      "type": "object"
    },
    "ListWorksMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "list_works",
          "default": "list_works",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ListWorksMessage",
      "type": "object"
    },
    "Mural": {
      "additionalProperties": false,
      "properties": {
        "work_id": {
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "artist": {
          "$ref": "#/$defs/Artist"
        },
        "statement": {
          "description": "The artist on what it's saying.",
          "type": "string"
        },
        "image": {
          "description": "The URL of the mural's image, /api/works/<work_id>.png.",
          "type": "string"
        }
      },
      "required": [
        "work_id",
        "title",
        "artist",
        "statement",
        "image"
      ],
      "title": "Mural",
      "type": "object"
    },
    "MuralsMessage": {
      "additionalProperties": false,
      "description": "Every mural wall and what's on it. Sent on connect and whenever a mural changes.",
      "properties": {
        "type": {
          "const": "murals",
          "default": "murals",
          "type": "string"
        },
        "walls": {
          "items": {
            "$ref": "#/$defs/Wall"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "walls"
      ],
      "title": "MuralsMessage",
      "type": "object"
    },
    "NewsArticle": {
      "additionalProperties": false,
      "properties": {
        "news_id": {
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "description": "The feed it came from, e.g. \"The Atlantic\". May be empty.",
          "type": "string"
        },
        "summary": {
          "description": "Plain text.",
          "type": "string"
        },
        "long_summary": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Three or four short paragraphs of plain text, separated by blank lines. Left out when there isn't one, so the client shows `summary`."
        },
        "url": {
          "description": "The original article.",
          "type": "string"
        },
        "read": {
          "description": "Whether the player has read it.",
          "type": "boolean"
        }
      },
      "required": [
        "news_id",
        "title",
        "source",
        "summary",
        "url",
        "read"
      ],
      "title": "NewsArticle",
      "type": "object"
    },
    "NewsMessage": {
      "additionalProperties": false,
      "description": "The articles at the news terminals, newest first. The reply to list_news and read_news.",
      "properties": {
        "type": {
          "const": "news",
          "default": "news",
          "type": "string"
        },
        "articles": {
          "items": {
            "$ref": "#/$defs/NewsArticle"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "articles"
      ],
      "title": "NewsMessage",
      "type": "object"
    },
    "Notice": {
      "additionalProperties": false,
      "description": "A short notice a shopkeeper, the `poster`, puts up at the terminals: an offer, an event or\nan invitation. It isn't a work.",
      "properties": {
        "notice_id": {
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "description": "The notice itself, with its line breaks.",
          "type": "string"
        },
        "poster": {
          "$ref": "#/$defs/Artist"
        },
        "created": {
          "description": "Sim time.",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "notice_id",
        "title",
        "text",
        "poster",
        "created"
      ],
      "title": "Notice",
      "type": "object"
    },
    "NpcStateMessage": {
      "additionalProperties": false,
      "description": "Debug state for the overlay. The fields in `state` are up to the modules that send them.",
      "properties": {
        "type": {
          "const": "npc_state",
          "default": "npc_state",
          "type": "string"
        },
        "npc_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "state": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      },
      "required": [
        "type",
        "npc_id",
        "state"
      ],
      "title": "NpcStateMessage",
      "type": "object"
    },
    "Painting": {
      "additionalProperties": false,
      "properties": {
        "work_id": {
          "minLength": 1,
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "artist": {
          "$ref": "#/$defs/Artist"
        },
        "statement": {
          "description": "The artist on what it's saying.",
          "type": "string"
        },
        "image": {
          "description": "The URL of the painting's image. Each work has its own.",
          "type": "string"
        }
      },
      "required": [
        "work_id",
        "title",
        "artist",
        "statement",
        "image"
      ],
      "title": "Painting",
      "type": "object"
    },
    "PaintingsMessage": {
      "additionalProperties": false,
      "description": "Every frame and the painting in it. Sent on connect and whenever a painting changes.",
      "properties": {
        "type": {
          "const": "paintings",
          "default": "paintings",
          "type": "string"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/Frame"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "frames"
      ],
      "title": "PaintingsMessage",
      "type": "object"
    },
    "PlayerMoveMessage": {
      "additionalProperties": false,
      "description": "A position without `map` is on the village. Side-view maps have no village, so there the\nserver ignores it, as it ignores any unknown map.\n\nOn a side-view map the position can be mid-air, jumping or falling. The server keeps one in\nopen air over somewhere to land if it's within the farthest, highest jump the player can make\nfrom somewhere to stand (a run jump with Space held, taking off as late as coyote time\nallows), or if it's lower than the last position it kept on that map, as in a fall from any\nheight. It ignores a position nobody could be at.",
      "properties": {
        "type": {
          "const": "player_move",
          "default": "player_move",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        }
      },
      "required": [
        "type",
        "position"
      ],
      "title": "PlayerMoveMessage",
      "type": "object"
    },
    "PlayerSayMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "player_say",
          "default": "player_say",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "description": "The NPC the player is talking to.",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text",
        "target"
      ],
      "title": "PlayerSayMessage",
      "type": "object"
    },
    "Pose": {
      "description": "What someone is doing where they are. `climbing` is on stairs or a ladder, and `riding` in\na lift.",
      "enum": [
        "standing",
        "walking",
        "sitting",
        "reading",
        "working",
        "looking",
        "climbing",
        "riding"
      ],
      "title": "Pose",
      "type": "string"
    },
    "Position": {
      "additionalProperties": false,
      "description": "Where an entity stands, in tiles: (4, 6) is on tile (4, 6). Fractions are mid-step. On a\nside-view map, x runs along the street and y counts rows down from the top, and fractions are\nmid-step or mid-climb, or for the player, mid-air in a jump or a fall.",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "map": {
          "default": "village",
          "description": "The map it's on. The server always sends it, and a client that leaves it out means the village.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    },
    "ReadNewsMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "read_news",
          "default": "read_news",
          "type": "string"
        },
        "news_id": {
          "description": "The article the player reads.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "news_id"
      ],
      "title": "ReadNewsMessage",
      "type": "object"
    },
    "ReadWorkMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "read_work",
          "default": "read_work",
          "type": "string"
        },
        "work_id": {
          "description": "The work the player reads.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "work_id"
      ],
      "title": "ReadWorkMessage",
      "type": "object"
    },
    "ServerMessage": {
      "discriminator": {
        "mapping": {
          "clock": "#/$defs/ClockMessage",
          "conversation_ended": "#/$defs/ConversationEndedMessage",
          "conversation_started": "#/$defs/ConversationStartedMessage",
          "entity_moved": "#/$defs/EntityMovedMessage",
          "line": "#/$defs/LineMessage",
          "murals": "#/$defs/MuralsMessage",
          "news": "#/$defs/NewsMessage",
          "npc_state": "#/$defs/NpcStateMessage",
          "paintings": "#/$defs/PaintingsMessage",
          "snapshot": "#/$defs/SnapshotMessage",
          "works": "#/$defs/WorksMessage"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SnapshotMessage"
        },
        {
          "$ref": "#/$defs/ClockMessage"
        },
        {
          "$ref": "#/$defs/EntityMovedMessage"
        },
        {
          "$ref": "#/$defs/ConversationStartedMessage"
        },
        {
          "$ref": "#/$defs/ConversationEndedMessage"
        },
        {
          "$ref": "#/$defs/LineMessage"
        },
        {
          "$ref": "#/$defs/NpcStateMessage"
        },
        {
          "$ref": "#/$defs/NewsMessage"
        },
        {
          "$ref": "#/$defs/WorksMessage"
        },
        {
          "$ref": "#/$defs/MuralsMessage"
        },
        {
          "$ref": "#/$defs/PaintingsMessage"
        }
      ]
    },
    "SnapshotMessage": {
      "additionalProperties": false,
      "description": "The whole world, sent on connect. Replaces anything the client had.",
      "properties": {
        "type": {
          "const": "snapshot",
          "default": "snapshot",
          "type": "string"
        },
        "time": {
          "description": "Sim time.",
          "format": "date-time",
          "type": "string"
        },
        "map_id": {
          "description": "The map the player starts on: the village, or a street on side-view maps.",
          "minLength": 1,
          "type": "string"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "type": "array"
        },
        "conversations": {
          "description": "Only those still going on.",
          "items": {
            "$ref": "#/$defs/Conversation"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "time",
        "map_id",
        "entities",
        "conversations"
      ],
      "title": "SnapshotMessage",
      "type": "object"
    },
    "Wall": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "map": {
          "default": "village",
          "description": "The map it's on, such as a street. Left out on the village.",
          "minLength": 1,
          "type": "string"
        },
        "x": {
          "description": "(x, y) is the building's tile at the west end of a south face or the north end of an east face: on its south row or east column, whatever storeys the mural spans. The face runs along that tile's south edge (y + 1) or east edge (x + 1). On a side-view map, it's the standing cell at the wall's west end, on the street in front of it.",
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "description": "(x, y) is the building's tile at the west end of a south face or the north end of an east face: on its south row or east column, whatever storeys the mural spans. The face runs along that tile's south edge (y + 1) or east edge (x + 1). On a side-view map, it's the standing cell at the wall's west end, on the street in front of it.",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "In tiles, east from (x, y) for a south face or south for an east face.",
          "minimum": 1,
          "type": "integer"
        },
        "face": {
          "$ref": "#/$defs/Face"
        },
        "bottom": {
          "description": "The mural's lower edge, in storeys above the ground there.",
          "minimum": 0,
          "type": "number"
        },
        "top": {
          "description": "The mural's upper edge, in storeys above the ground there.",
          "type": "number"
        },
        "mural": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mural"
            },
